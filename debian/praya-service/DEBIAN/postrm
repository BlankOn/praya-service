#!/bin/bash
set -e

case "$1" in
    purge)
        # Note: User data in ~/.local/share/praya is NOT removed
        # This is intentional - users may want to keep their calibration
        echo "Note: User data in ~/.local/share/praya was not removed."
        echo "Remove it manually if desired."
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Update icon cache
        if command -v gtk-update-icon-cache &> /dev/null; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # Update desktop database
        if command -v update-desktop-database &> /dev/null; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi
        ;;
esac

# Automatically added by dh_installsystemduser/13.29
if [ "$1" = "purge" ]; then
	if [ -z "$DPKG_ROOT" ] && [ -x "/usr/bin/deb-systemd-helper" ] ; then
		deb-systemd-helper --user purge 'praya.service' >/dev/null || true
	fi
fi
# End automatically added section


exit 0
