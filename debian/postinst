#!/bin/bash
set -e

case "$1" in
    configure)
        # Update icon cache
        if command -v gtk-update-icon-cache &> /dev/null; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # Update desktop database
        if command -v update-desktop-database &> /dev/null; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi

        echo ""
        echo "Praya Posture Service installed successfully!"
        echo ""
        echo "To start the posture service:"
        echo "  praya-posture                           # Run directly"
        echo "  systemctl --user start praya-posture    # Start as service"
        echo "  systemctl --user enable praya-posture   # Enable on login"
        echo ""
        echo "Note: First run will download AI models (~30MB)."
        echo ""
        ;;
esac

#DEBHELPER#

exit 0
