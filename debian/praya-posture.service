[Unit]
Description=Praya Posture Service - Posture monitoring
Documentation=https://github.com/herpiko/praya
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/praya-posture
Restart=on-failure
RestartSec=5

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=default.target
