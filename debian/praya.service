[Unit]
Description=Praya Service Daemon - Wellness platform
Documentation=https://github.com/herpiko/praya
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/praya-service
Restart=on-failure
RestartSec=5

# Note: Requires WAYLAND_DISPLAY and XDG_RUNTIME_DIR in systemd user environment
# Run: systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR

# Resource limits – idle daemon uses ~80 MB (GTK + D-Bus only);
# posture service with camera/ML adds ~300-400 MB on top.
MemoryMax=768M
MemoryHigh=512M
CPUQuota=50%

[Install]
WantedBy=default.target
